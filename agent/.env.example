# LLM 配置（OpenAI 兼容）。全部留空时使用内置确定性 MockLLM
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM 调用超时（秒），所有外部 LLM 调用必须设置 timeout
LLM_TIMEOUT_S=60
# 服务端口
AGENT_PORT=8000
# Calendar 只读工具（Phase 5）：ICS 文件路径（从任意日历导出）。留空 = 工具停用
CAL_ICS_PATH=
# 容量推断参数：每日总可支配窗口（分钟），available = max(0, 窗口 - 忙碌)
CAL_DAILY_WINDOW_MINUTES=720

# Calendar Provider 选择（Phase 8）：ics（默认，本地文件）| google（真实 Google Calendar）
CALENDAR_PROVIDER=ics
# Google OAuth（CALENDAR_PROVIDER=google 时必需）：
#   credentials = Google Cloud Console 的 OAuth 客户端（Desktop）client_secret JSON
#   token file = refresh_token 持久化位置（gitignore，勿提交）
#   calendar id = 目标日历（默认 primary，由用户显式配置，LLM 不猜测）
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=.google-token.json
GOOGLE_CALENDAR_ID=primary

# ---- Phase 8.5：Provider Hardening ----
# token 存储后端：file（开发，默认）| keyring（生产，OS 凭据管理器）
LIFEOS_TOKEN_STORE=file
# 环境标识：production + file 存储 = 拒绝启动（禁明文生产运行）
LIFEOS_ENV=
# 读操作重试退避基数（秒）：实际退避 = base * 2^n + 抖动；429 优先 Retry-After
LIFEOS_GOOGLE_BACKOFF_BASE=0.5
