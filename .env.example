# 数据库（SQLite 开发默认；schema 兼容 PostgreSQL）
DATABASE_URL="file:./dev.db"
# LLM（OpenAI 兼容端点）。留空则两侧都使用内置确定性 mock，闭环仍可运行
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# Python Agent Core：
#   auto   = Python 优先，不可达/超时/5xx/契约不匹配/版本不一致 → 自动降级 local（推荐）
#   local  = 只走 TS 本地路径（完全离线/排障）
#   python = 只走 Python，失败直接报错（评测用）
AGENT_MODE="auto"
AGENT_CORE_URL="http://127.0.0.1:8000"
# 分层超时默认（秒级预算见 src/lib/agent/*）：LLM 180s / Calendar 120s / Execute 270s。
# 如需整体覆盖可设置 AGENT_TIMEOUT_MS（例如网络极快可调低）：
# AGENT_TIMEOUT_MS="180000"
