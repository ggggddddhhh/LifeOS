# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!agent/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
prisma/*.db
prisma/*.db-journal

# python agent
agent/.venv/
agent/__pycache__/
**/__pycache__/
.pytest_cache/

# google oauth token（按用户分文件 + 授权会话，均不入库）
agent/.google-token.json
agent/.google-token-*.json
agent/.google-auth-session.json
agent/google-credentials.json

# phase9 dogfood trace/state
logs/
agent/logs/

# demo recordings（仅终片 mp4 入库）
recordings/*.webm
recordings/concat.txt

# zcode 插件本地状态
.v2c/

# python agent 字节码/工具缓存
agent/.venv*/
.ruff_cache/
